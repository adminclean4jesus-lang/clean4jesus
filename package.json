{
  "name": "clean4jesus",
  "version": "1.3.46",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/lexend-deca": "^0.4.1",
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo-google-fonts/nunito-sans": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@supabase/supabase-js": "2.110.5",
    "clean4jesus-ios-protection": "file:./modules/clean4jesus-ios-protection",
    "expo": "^57.0.9",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-intent-launcher": "~57.0.1",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "3.19.5",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "4.0.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@playwright/test": "^1.61.0",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~57.0.0",
    "metro-runtime": "^0.83.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.9"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-reanimated"
      ]
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "phone": "expo start --host lan --clear",
    "phone:tunnel": "expo start --tunnel --clear",
    "dev-client": "expo start --dev-client --host lan --clear",
    "dev-client:tunnel": "expo start --dev-client --tunnel --clear",
    "dev-client:localhost": "expo start --dev-client --localhost --clear",
    "eas:login": "npx eas-cli login",
    "eas:whoami": "npx eas-cli whoami",
    "prebuild:android": "expo prebuild --platform android",
    "build:android:local": "cd android && gradlew.bat :app:assembleRelease -PreactNativeArchitectures=arm64-v8a --no-daemon --max-workers=1 && cd .. && node scripts/rotate-local-android-apk.mjs",
    "artifacts:android:rotate": "node scripts/rotate-local-android-apk.mjs",
    "test:repository-hygiene": "node scripts/verify-repository-hygiene.mjs",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "test:auth:readiness": "node scripts/verify-auth-production-readiness.mjs",
    "test:auth:surfaces": "node scripts/verify-production-auth-surfaces.mjs",
    "supabase:auth:push": "node scripts/push-auth-captcha.mjs",
    "test:supabase:auth-push-launcher": "node scripts/verify-auth-config-push-launcher.mjs",
    "test:runtime-gate": "node scripts/verify-runtime-version-gate.mjs",
    "test:supabase:security": "node scripts/verify-supabase-security.mjs",
    "test:supabase:negative": "node scripts/verify-supabase-negative-contracts.mjs",
    "content:devotional:seed": "node scripts/generate-devotional-catalog-seed.mjs",
    "content:devotional:publish": "node scripts/generate-devotional-catalog-seed.mjs --write-new",
    "content:daily:seed": "node scripts/generate-daily-devotional-seed.mjs",
    "content:daily:publish": "node scripts/generate-daily-devotional-seed.mjs --write-new",
    "admin:dev": "npm --prefix moderation-console run dev",
    "admin:build": "node scripts/build-moderation-console.mjs",
    "legal:build": "node scripts/build-legal-site.mjs",
    "legal:deploy": "npm run legal:build && npx wrangler deploy --config wrangler.legal.jsonc",
    "landing:build": "node scripts/build-landing-site.mjs",
    "test:landing": "npm run landing:build && node scripts/validate-landing-layout.mjs",
    "landing:deploy": "npm run landing:build && npx wrangler deploy --config wrangler.landing.jsonc",
    "postinstall": "node scripts/patch-apple-targets.mjs"
  },
  "overrides": {
    "browserslist": "4.29.3",
    "postcss": "8.5.28",
    "shell-quote": "1.11.0"
  },
  "private": true
}
