        <action android:name="android.net.VpnService"/>
      </intent-filter>
      <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Local DNS protection for Clean4Jesus"/>
    </service>
  </application>
</manifest>
